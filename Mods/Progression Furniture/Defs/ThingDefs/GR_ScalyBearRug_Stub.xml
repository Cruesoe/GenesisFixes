<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- Inert stub so "Progression: Furniture" (ferny.progressionfurniture)'s Dinosauria-rug
	     research patch (ve_genetics_rugs_vfe_art_research.xml) finds a def to attach
	     researchPrerequisites to. GR_ScalyBearRug is real content from "Vanilla Genetics
	     Expanded", but that mod only loads it when spincrus.dinosauria or
	     BiomesTeam.BiomesPrehistoric is active (see that mod's LoadFolders.xml). Without
	     either active, Progression: Furniture's patch throws "Failed to find a node with
	     the given xpath" on both its match and nomatch branches. This stub exists only to
	     satisfy that xpath - no designationCategory, no recipe produces it, and
	     tradeability is None, so it can never be built, crafted, sold, or otherwise
	     encountered in play. -->
	<ThingDef>
		<defName>GR_ScalyBearRug</defName>
		<label>scaly bear rug (unused stub)</label>
		<description>Placeholder def. Never spawned, built, or referenced - see Genesis Fixes.</description>
		<thingClass>ThingWithComps</thingClass>
		<category>Item</category>
		<graphicData>
			<!-- Use an always-present Core texture. Steel's own texture is split into _a/_b/_c
			     stack-count frames rather than one flat file at this path, so this has to match
			     Steel's own graphicClass (Graphic_StackCount) - Graphic_Single looks for a
			     texture literally at this exact path and finds nothing, throwing a "Could not
			     load Texture2D" error and a "MatFrom with null sourceTex" error right after it.
			     The real rug texture is loaded only with the same optional genetics content
			     whose absent def this stub replaces. -->
			<texPath>Things/Item/Resource/Steel</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<Mass>5</Mass>
		</statBases>
		<selectable>false</selectable>
		<tradeability>None</tradeability>
	</ThingDef>

</Defs>
